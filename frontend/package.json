{
  "name": "frontend",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "test": "jest --watchAll",
    "test:ci": "jest",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "globalSetup": "<rootDir>/jest.globalSetup.js",
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "setupFiles": [
      "<rootDir>/jest.setup.fonts.ts"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.i18n.ts"
    ],
    "collectCoverageFrom": [
      "{app,components,context,hooks,screens,services,utils}/**/*.{ts,tsx}",
      "!**/__test__/**"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 90,
        "statements": 90,
        "functions": 87,
        "branches": 79
      }
    }
  },
  "dependencies": {
    "@expo/html-elements": "^0.13.7",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "^5.2.0",
    "@react-native-vector-icons/evil-icons": "^12.5.0",
    "@react-native-vector-icons/fontawesome": "^12.5.0",
    "@react-native-vector-icons/fontawesome6": "^12.4.0",
    "@react-native-vector-icons/material-design-icons": "^12.5.0",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/elements": "^2.9.44",
    "@react-navigation/native": "^7.5.0",
    "@testing-library/react": "^16.3.3",
    "axios": "^1.20.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "dotenv": "^17.4.2",
    "expo": "~57.0.27",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.5.11",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^17.1.9",
    "react-native": "^0.86.3",
    "react-native-css-interop": "^0.2.7",
    "react-native-date-picker": "^5.0.13",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-gifted-charts": "^1.4.81",
    "react-native-health": "^1.19.0",
    "react-native-health-connect": "^4.1.3",
    "react-native-maps": "^1.27.2",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "^0.10.1",
    "victory": "^37.3.6",
    "victory-native": "^41.20.2"
  },
  "devDependencies": {
    "@expo/config-plugins": "~57.0.10",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/mocha": "^10.0.10",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.14",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "jsdom": "^27.4.0",
    "react-test-renderer": "^19.2.3",
    "ts-jest": "^29.4.14",
    "typescript": "~5.9.2"
  },
  "private": true,
  "fontDir": {
    "reactNativeVectorIcons": {
      "fontDir": "src/rnvi-fonts"
    }
  },
  "overrides": {
    "@expo/cli": "57.0.28"
  }
}
