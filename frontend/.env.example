# Copy to .env and fill in. Never commit .env.

# Backend API, e.g. http://192.168.0.96:4000/api (find the IP with: ipconfig getifaddr en0)
EXPO_PUBLIC_API_URL=

# Google web services key (Geocoding API + Places API), used by the app at runtime.
# Restrict it to those two APIs in Google Cloud. It ships inside the app bundle.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=

# Demo health data unless set to "false"
EXPO_PUBLIC_USE_MOCK_HEALTH=

# "true" walks the route with simulated GPS (for testing at home); real GPS otherwise
EXPO_PUBLIC_USE_MOCK_GPS=

# Google Maps SDK keys for native builds (read by app.config.ts at build time).
# Restrict them to the app: iOS bundle id / Android package com.walkit.app.
# For EAS builds, set them as EAS environment variables instead.
GOOGLE_MAPS_IOS_KEY=
GOOGLE_MAPS_ANDROID_KEY=
