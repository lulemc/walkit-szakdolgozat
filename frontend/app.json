{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
       "config": {
        "googleMapsApiKey": "AIzaSyBmTTxZ5x_NIQlKyIGJaf3aqNZTgRxFLh8"
      },
            "bundleIdentifier": "com.walkit.app",
  "infoPlist": {
        "NSHealthShareUsageDescription": "We need access to your health data to show your walking statistics and track your progress.",
        "NSHealthUpdateUsageDescription": "We need access to update your health data with your walking activities.",
        "UIBackgroundModes": ["fetch"]
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
       "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBmTTxZ5x_NIQlKyIGJaf3aqNZTgRxFLh8"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
